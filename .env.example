# ==============================================================================
# AyuCTMS — Environment Configuration Example
# ==============================================================================

# Core Application & Security
DATABASE_URL=sqlite+aiosqlite:///./ctms.db
API_V1_PREFIX=/api/v1
PROJECT_NAME=AyuCTMS
SECRET_KEY=replace-with-a-secure-32-byte-secret-key-in-production

# Platform Super Admin Initial Bootstrap
SUPER_ADMIN_EMAIL=admin@ayuctms.example
SUPER_ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-bootstrap-password
SUPER_ADMIN_ACTIVATION_MODE=bootstrap_password

# Frontend Web Application URL
APP_BASE_URL=http://localhost:5173

# Email Delivery Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy SMTP Configuration (fallback if enabled)
MAIL_ENABLED=false
MAIL_FROM=noreply@ayuctms.example
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
