# ==============================================================================
# AyuCTMS — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env and configure the variables for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Deployment Target (Universal Dockerfile Selector)
# ------------------------------------------------------------------------------
# Set which service this container should run:
#   - "frontend" : Runs only the Node.js Vite Preview frontend (DEFAULT if unset)
#   - "backend"  : Runs only the FastAPI Python backend with Uvicorn
#   - "both"     : Runs both services in a single container (monolith mode)
SERVICE=frontend

# Server listening port (automatically overridden by cloud providers like Fly.io / Antideploy via $PORT)
PORT=5173

# Number of Uvicorn workers (backend mode only, default: 2)
WORKERS=2

# Persistent data directory for SQLite database and uploaded documents
DATA_DIR=/app/data


# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Used when SERVICE=frontend)
# ------------------------------------------------------------------------------
# The URL of your deployed Backend service.
# The frontend preview server proxies /api calls to this URL without CORS issues.
BACKEND_URL=http://127.0.0.1:8000
# Example for cloud deployment:
# BACKEND_URL=https://your-backend.antideploy.app

# API base path (defaults to /api/v1)
VITE_API_BASE_URL=/api/v1


# ------------------------------------------------------------------------------
# 3. Backend Database & Core Security (Used when SERVICE=backend)
# ------------------------------------------------------------------------------
# Database Connection URL:
# For SQLite (default development / embedded):
DATABASE_URL=sqlite+aiosqlite:////app/data/ctms.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db-host:5432/ayuctms

# REST API prefix
API_V1_PREFIX=/api/v1
PROJECT_NAME=AyuCTMS

# Cryptographic Secret Key for signing JWT authentication tokens (generate a strong 32+ byte string)
SECRET_KEY=replace-with-a-secure-32-byte-secret-key-in-production

# Public URL of the Frontend Web Application (used in email activation / invitation links)
APP_BASE_URL=http://localhost:5173
# Example for cloud deployment:
# APP_BASE_URL=https://ctms.antideploy.app


# ------------------------------------------------------------------------------
# 4. Platform Authority & Super Admin Bootstrap (Backend)
# ------------------------------------------------------------------------------
# Initial platform super admin credentials for first boot
SUPER_ADMIN_EMAIL=admin@ayuctms.example
SUPER_ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-bootstrap-password
SUPER_ADMIN_ACTIVATION_MODE=bootstrap_password

# Optional explicit platform authority organization ID
PLATFORM_ORGANIZATION_ID=


# ------------------------------------------------------------------------------
# 5. Email Notification Delivery (Resend / SMTP)
# ------------------------------------------------------------------------------
# Resend API Service (recommended)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Legacy SMTP Configuration (fallback if enabled)
MAIL_ENABLED=false
MAIL_FROM=noreply@ayuctms.example
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
