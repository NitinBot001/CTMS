# ==============================================================================
# AyuCTMS Frontend — Environment Configuration Example
# ==============================================================================

# Backend API server URL for reverse proxying /api calls
BACKEND_URL=http://127.0.0.1:8000
# In production cloud deployment:
# BACKEND_URL=https://your-backend.antideploy.app

# Frontend API base path (defaults to /api/v1)
VITE_API_BASE_URL=/api/v1

# Frontend server listening port
PORT=5173
